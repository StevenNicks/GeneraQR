{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "dev:https",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev:https",
        "-w",
        "web"
      ],
      "port": 3000,
      "url": "https://localhost:3000"
    }
  ]
}
