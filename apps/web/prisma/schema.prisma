generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model PdfRecord {
  id           String   @id @default(uuid())
  // Short slug used in the QR's target URL (/r/:shortId) instead of the
  // full Blob URL, so the QR encodes far less data and can render as a
  // simpler symbol.
  shortId      String   @unique
  originalName String
  pdfPath      String
  qrPath       String
  size         Int
  createdAt    DateTime @default(now())

  @@map("pdf_records")
}
